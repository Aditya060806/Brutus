# =====================================================================
# BRUTUS AUTH BACKEND - ENV TEMPLATE
# =====================================================================
# Copy this file in your backend project as `.env` and set real values.

# Server
PORT=4000
NODE_ENV=development

# Google OAuth credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# This must match your backend route that handles Google callback
GOOGLE_CALLBACK_URL=http://localhost:4000/users/google/callback

# JWT secrets
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret

# Optional token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS / client origins
FRONTEND_URL=http://localhost:3000
ELECTRON_ORIGIN=app://-

# Desktop deep-link target after successful OAuth in backend
# Example redirect your backend should issue:
# brutus://oauth?accessToken=<ACCESS>&refreshToken=<REFRESH>
DESKTOP_DEEP_LINK=brutus://oauth
